# Required — text/image/strategy generation
OPENAI_API_KEY=your_openai_api_key_here

# Required for real GENIUS SSO flows
SSO_SECRET=your_shared_sso_secret
# Optional during secret rotation or while GENIUS still signs with an older secret
SSO_FALLBACK_SECRET=optional_previous_shared_sso_secret

# Required if the app is embedded in an iframe from another origin
ALLOWED_ORIGINS=http://localhost:3000
# Optional — override canonical sign-in/callback origins for a preview environment
ENGAGE_APP_URL=https://engageagent.ai4genius.org
GENIUS_URL=https://learn.ai4genius.org

# Optional — video generation
GROK_API_KEY=your_grok_api_key_here

# Optional — model overrides
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Slides reuse OPENAI_API_KEY. Leave blank for the Slides-only gpt-6.1-sol default.
# Set an explicit override here or choose a model in the Slides workspace.
OPENAI_SLIDES_MODEL=
# Text + Image checks and image generation; Slides retain their own selected model.
OPENAI_MATERIAL_REVIEW_MODEL=gpt-4.1
OPENAI_VLM_MODEL=gpt-4o
OPENAI_MATERIAL_IMAGE_QUALITY=medium
# Optional; omit to keep the strategy-specific fallback chosen by the app.
# OPENAI_FALLBACK_MODEL=gpt-4.1

# Optional — AWS-backed persistence
# If these are omitted, the app falls back to local JSON storage in `data/engage-nosql.json`.
DYNAMODB_TABLE=genius_engage_agent_data
ENGAGE_AWS_REGION=us-east-2
ENGAGE_AWS_ACCESS_KEY_ID=your_aws_access_key_id
ENGAGE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
ENGAGE_S3_BUCKET=genius-engage-agent-media
COHORT_ANALYSIS_QUEUE_URL=

# Optional — script tuning
FEEDBACK_TICKET_CONCURRENCY=6
